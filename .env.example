CHART_LISTEN_TCP=127.0.0.1:9101
CHART_STATE_FIELDS=abc;banana;foo;bar

CHART_CMD_TCP=127.0.0.1:9001
CHART_CMD_LIST=ping;reload;snapshot;pause;resume;set_threshold;transform

CHART_CMD_ping=
CHART_CMD_reload=force:int=0
CHART_CMD_snapshot=name:string=default;quality:float=0.8
CHART_CMD_set_threshold=value:float=1.5;window:int=30;label:string=alpha
CHART_CMD_transform=amount:float:mul_1e9_u64=1.5
